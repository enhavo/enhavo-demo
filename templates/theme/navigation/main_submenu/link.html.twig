<li class="main-nav__subitem">
    {% if node.subject.link %}
        <a class="main-nav__sublink" href="{{ node.subject.link }}" target="{{ node.subject.target|default('_self') }}">{{ node.label }}</a>
    {% else %}
        <span class="main-nav__sublink">{{ node.label }}</span>
    {% endif %}
</li>
