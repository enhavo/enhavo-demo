<div class="block-swipe-teaser" data-controller="swiper-teaser">
    {% if block.headline %}
        <div class="theme-headline {{ block.titleAlignment }}">{{ block.headline|html_sanitize }}</div>
    {% endif %}
    <div class="grid" data-swiper-teaser-target="slide">
        {% for item in block.items %}
            <div class="slide">
                <div class="slide-inner">
                    <div class="media-wrapper">
                        <img src="{{ media_url(item.picture) }}" alt="{{ media_parameter(item.picture,'alt') }}" class="media-gradient">
                    </div>
                    <div class="text-wrapper">
                        <div class="text-container">
                            <div class="theme-overline">{{ item.overline|html_sanitize }}</div>
                            <div class="theme-headline padding">{{ item.headline|html_sanitize }}</div>
                            <div class="copy">{{ item.text|html_sanitize }}</div>
                        </div>
                        <div class="theme-button-container">
                            <div class="btn-wrapper">
                                {# The entity stores the CTA as label/link/target; the template-preview
                                   env passes ctaTitle/ctaLink/ctaTarget. Fall back between the two. #}
                                <a class="theme-cta theme-button"
                                   href="{{ item.link is defined and item.link ? item.link : (item.ctaLink is defined ? item.ctaLink : '#') }}"
                                   target="{{ item.target is defined and item.target ? item.target : (item.ctaTarget is defined ? item.ctaTarget : '_self') }}">{{ item.label is defined and item.label ? item.label : (item.ctaTitle is defined ? item.ctaTitle : '') }}</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
