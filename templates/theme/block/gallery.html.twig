<div class="block-gallery layout-{{ block.layout }}">
    <div class="theme-container">
        <div class="grid"{% if block.layout == 'columns' %} data-controller="gallery"{% endif %}>
            {% if block.items is defined %}
                {% for item in block.items %}
                    <div class=" item{% if loop.first %} active{% endif %}" data-gallery-target="item">
                        <div class="text-container">
                            {% if item.title is defined%}<span class="theme-headline headline">{{ item.title|html_sanitize }}</span>{% endif %}
                            {% if item.description is defined %}<div class="copy">{{ item.description|html_sanitize }} </div>{% endif %}
                        </div>
                        <img src="{{ media_url(item.picture) }}" alt="{{ media_parameter(item.picture, 'alt') }}" class="gallery-img">
                    </div>
                {% endfor %}
            {% endif %}
            {% if block.layout == 'columns' %}
                <div class="ex-toggle" data-action="click->gallery#toggle">
                    <div class="lines"></div>
                </div>
                <button class="prev-button" data-action="click->gallery#prev">
                    <svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" viewBox="0 0 18 31" fill="none">
                        <path d="M15.6953 1.5L2 15.1953L15.6953 28.8906" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
                 <button class="next-button" data-action="click->gallery#next">
                     <svg xmlns="http://www.w3.org/2000/svg" width="17" height="31" viewBox="0 0 17 31" fill="none">
                         <path d="M1.5 28.8906L15.1953 15.1953L1.5 1.5" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                     </svg>
                </button>
            {% endif %}

            {% if block.media is defined %}
            <div class="image-container">
                <img src="{{ media_url(block.picture) }}" alt="{{ media_parameter(block.picture, 'alt') }}" class="">
            </div>
            {% endif %}
        </div>
    </div>
</div>
