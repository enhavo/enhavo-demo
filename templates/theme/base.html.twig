<!DOCTYPE html>
<html lang="de" data-controller="app cookie-consent">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=Edge"/>
    <meta http-equiv="Content-type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0">
    <meta charset="utf-8" />
    <title>{% block page_title %}Enhavo-Demo{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}{% endblock %}" />
    <meta property="og:url" content="{% block og_url %}{{ app.request.schemeAndHttpHost }}{{ app.request.uri }}{% endblock %}" />
    <meta property="og:title" content="{% block og_title %}{% endblock %}" />
    <meta property="og:description" content="{% block og_description %}{% endblock %}" />
    <meta property="og:image" content="{% block og_image %}{% endblock %}" />
    <meta name="robots" content="{% block robots %}INDEX,FOLLOW{% endblock %}">
    <link rel="canonical" href="{{ app.request.uri|split("?")[0] }}"/>

    <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('build/theme/images/favicon/favicon-16x16.svg', 'vite') }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('build/theme/images/favicon/favicon-32x32.svg', 'vite') }}">
    <link rel="icon" type="image/png" sizes="96x96" href="{{ asset('build/theme/images/favicon/favicon-96x96.png', 'vite') }}">
{##}
    <!-- Apple Touch Icon (iPhone & iPad Homescreen) -->
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('build/theme/images/favicon/apple-touch-icon.png', 'vite') }}">
{##}
    <!-- Android/Chrome App Icon -->
    <link rel="icon" type="image/png" sizes="192x192" href="{{ asset('build/theme/images/favicon/android-icon-192x192.png', 'vite') }}">
{##}
    {{ vite_css_tags('entrypoints/main.js', 'theme') }}

    {% block structuredData %}{% endblock %}

</head>
<body id="top">

{% block header %}
    {% include 'theme/component/header.html.twig' %}

{% endblock %}

<main>
    {% block main %}{% endblock %}
</main>

{{ vite_js_tags('entrypoints/main.js', 'theme') }}

{% if routes is defined %}
    <script id="routes" type="application/json">{{ routes|json_encode|e }}</script>
{% endif %}
{% block footer %}
    {% include 'theme/component/footer.html.twig' %}
{% endblock %}

</body>
</html>