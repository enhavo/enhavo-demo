{% extends template('theme/base.html.twig') %}

{% block main %}
    <div class="login-page form-input">
        <div class="theme-container">
            <h1 class="login-page__headline theme-headline">Willkommen beim Enhavo-Demo Login</h1>
            <div class="login-page__form-container">
                <div data-controller="form"
                     data-form-form-value="{{ form|json_encode|e }}"
                     data-form-component-value="form-login">
                </div>
                <div class="login-page__links">
                    <a href="{{ path('enhavo_user_theme_reset_password_request') }}">Forgot password?</a>
                    <a href="{{ path('enhavo_user_theme_registration_register') }}">Create account</a>
                </div>
            </div>
        </div>
    </div>
{% endblock main %}
